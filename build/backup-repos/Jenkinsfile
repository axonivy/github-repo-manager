pipeline {
  agent {
    dockerfile {
      dir 'build/docker'
    }
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  triggers {
    cron '@weekly'
  }

  stages {
    stage('backup:axonivy') {
      steps {
        script {
          mirrorOrg('axonivy')
        }
      }
    }
    stage('backup:axonivy-market') {
      steps {
        script {
          mirrorOrg('axonivy-market')
        }
      }
    }
    stage('store:nas') {
      steps {
        script {
          sshagent(credentials: ['zugprojenkins-ssh']) {
            sh 'rsync -r -e "ssh -o StrictHostKeyChecking=no" build/backup-repos/target/backup/ ubuntu@nas.ivyteam.io:/data/archive/github/'
          }
        }
      }
    }
  }
}

def mirrorOrg(String org) {
  withCredentials([file(credentialsId: 'github-ivyteam-token-repo-manager', variable: 'GITHUB_TOKEN_FILE')]) {
    sh """
      gh auth login --with-token < ${GITHUB_TOKEN_FILE}
      gh auth setup-git
    """
    sh "build/backup-repos/backup-org.sh ${org}"
  }
}
